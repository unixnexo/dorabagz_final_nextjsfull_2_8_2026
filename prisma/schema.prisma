// ============================================================================
// PRISMA SCHEMA — Module 1: Auth & Users
// More models (Product, Order, Story, etc.) will be added in later modules.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id String @id @default(cuid())

  // --- Identity ---
  phoneNumber String  @unique // e.g. 09123456789 — required, unique across app
  fullName    String?
  nationalCode String? // Iranian کد ملی, validated in app layer (checksum)
  birthDate   DateTime? // stored as UTC date, no time component needed
  email       String?
  profilePicUrl String? // e.g. /uploads/profile-pics/xxxx.jpg (served from /public)
  ipAddress   String? // last known IP, updated on login

  role     Role    @default(USER)
  isActive Boolean @default(true) // admin can deactivate a user

  // --- OTP login flow ---
  otpCodeHash     String? // bcrypt hash of current OTP, never store plain
  otpExpiresAt    DateTime?
  otpPurpose      OtpPurpose? // LOGIN or PHONE_CHANGE — same fields, different purpose
  pendingPhoneNumber String? // new number waiting for OTP confirmation (phone change flow)

  // --- Lockout after failed OTP attempts ---
  failedOtpAttempts Int       @default(0)
  lockedUntil       DateTime? // null = not locked

  // --- Timestamps ---
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastLoginAt DateTime?

  // --- Relations ---
  impersonationsAsAdmin  ImpersonationLog[] @relation("AdminImpersonations")
  impersonationsAsTarget ImpersonationLog[] @relation("TargetImpersonations")

  favorites Favorite[]
  cartItems CartItem[]

  address        Address?
  orders         Order[]
  couponUsages   CouponUsage[]
  assignedCoupons Coupon[] @relation("AssignedCoupons")

  pushSubscriptions PushSubscription[]
  notifications     Notification[]

  productReviews           ProductReview[]
  siteSatisfactionRatings  SiteSatisfactionRating[]
  popupDismissals          PopupDismissal[]
  storyViews               StoryView[]

  @@index([phoneNumber])
  @@index([role])
}

enum OtpPurpose {
  LOGIN
  PHONE_CHANGE
}

// Records every time an admin impersonates a user, for accountability.
model ImpersonationLog {
  id String @id @default(cuid())

  adminId String
  admin   User   @relation("AdminImpersonations", fields: [adminId], references: [id])

  targetUserId String
  targetUser   User   @relation("TargetImpersonations", fields: [targetUserId], references: [id])

  startedAt DateTime  @default(now())
  endedAt   DateTime? // set when admin returns to admin panel / token expires

  @@index([adminId])
  @@index([targetUserId])
}

// ============================================================================
// MODULE 2 — Categories & Products
// ============================================================================

// Two-level tree: a category with parentId = null is a "top-level" category.
// A category with parentId set is a child (max depth enforced in app logic,
// not in the schema — Prisma can't express "depth <= 2" declaratively).
model Category {
  id    String  @id @default(cuid())
  title String
  imageUrl String?

  parentId String?
  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")

  products Product[]
  couponCategories CouponCategory[]

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Product {
  id String @id @default(cuid())

  title       String
  description String?
  slug        String @unique // slugify(title) + "-" + productCode, generated on create
  productCode String @unique // auto-generated, e.g. "PRD-8F3K2L"

  videoUrl String? // one optional video, up to 30s, size-limited (no server compression yet)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  images        ProductImage[]
  specifications ProductSpecification[]
  options       ProductOption[]
  variants      ProductVariant[]
  favorites     Favorite[]
  couponProducts CouponProduct[]
  storyProducts StoryProduct[]

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isDeleted])
}

// Up to 5 additional images + 1 main image, distinguished by isMain.
// All images (including main) are compressed to WebP on upload.
model ProductImage {
  id  String @id @default(cuid())
  url String

  isMain    Boolean @default(false)
  sortOrder Int     @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Free-form key/value specs, e.g. "جنس بدنه" -> "آلومینیوم". Stored as rows
// (not JSON) so they're editable as a normal repeating form and stay ordered.
model ProductSpecification {
  id    String @id @default(cuid())
  key   String
  value String
  sortOrder Int @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// A dynamic option type for a product, e.g. "Size" or "Color".
// Different products can have completely different option sets.
model ProductOption {
  id   String @id @default(cuid())
  name String // e.g. "Size", "Color", "رنگ"
  sortOrder Int @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  values ProductOptionValue[]

  @@index([productId])
}

// A specific value for an option, e.g. "Red", "SM".
model ProductOptionValue {
  id    String @id @default(cuid())
  value String // e.g. "Red", "SM"
  sortOrder Int @default(0)

  optionId String
  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  variantLinks VariantOptionValue[]

  @@index([optionId])
}

// One purchasable SKU. Every product has at least one variant, even if it
// has no real options (e.g. a glass) — in that case the variant simply has
// no linked option values. This keeps Cart/Order logic uniform: they always
// reference a variantId, never a bare productId.
model ProductVariant {
  id String @id @default(cuid())

  price Int // Toman, integer, no decimals
  stock Int @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  optionValues VariantOptionValue[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// Join table: which option values make up a given variant
// (e.g. variant #1 = {Size: SM} + {Color: Red}).
model VariantOptionValue {
  id String @id @default(cuid())

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  optionValueId String
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionValueId])
  @@index([variantId])
  @@index([optionValueId])
}

// ============================================================================
// MODULE 3 — Favorites & Cart
// ============================================================================

// Favorites reference the PRODUCT (not a specific variant) — per your spec,
// "favorite" is about the product itself, not a size/color pick.
model Favorite {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId]) // a user can only favorite a product once
  @@index([userId])
  @@index([productId])
}

// Cart items always reference a VARIANT (never a bare product) — this keeps
// checkout logic uniform, per the design established in Module 2. Cart
// itself never reserves/locks stock; that only happens at Order/payment
// time (future module).
model CartItem {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, variantId]) // one row per user+variant, quantity accumulates
  @@index([userId])
  @@index([variantId])
}

// ============================================================================
// MODULE 4 — Address, Coupons, Orders, Payment
// ============================================================================

// Per your spec: only ONE address per user, always overwritten in place
// (no address book / history). Enforced by @@unique([userId]) below.
model Address {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  receiverFullName String
  receiverPhone    String
  province         String // استان
  city             String // شهر — "شیراز" triggers Snapp Box courier, else Tipax
  fullAddress      String // متن کامل آدرس
  postalCode       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponScope {
  ENTIRE_CART
  SPECIFIC_PRODUCTS
  SPECIFIC_CATEGORIES
}

model Coupon {
  id   String @id @default(cuid())
  code String @unique // admin-typed or auto-generated if left blank

  type  CouponType
  value Int // percent (1-100) if PERCENT, Toman amount if FIXED

  // Only meaningful when type = PERCENT — caps the discount so a big cart
  // doesn't get an unbounded percentage-off. Null = uncapped.
  maxDiscountAmount Int?

  scope CouponScope @default(ENTIRE_CART)
  // When scope = SPECIFIC_PRODUCTS / SPECIFIC_CATEGORIES, the discount only
  // applies to the matching items' subtotal (per your confirmed spec) —
  // matches are stored in the join tables below.
  products   CouponProduct[]
  categories CouponCategory[]

  minOrderAmount Int? // optional: cart total (Toman) must be >= this to apply

  maxUsesPerUser Int  @default(1) // almost always 1, but kept configurable
  maxTotalUsage  Int? // null = unlimited across all users ("first 10 people" case)

  assignedUserId String? // if set, ONLY this user may use the coupon
  assignedUser   User?   @relation("AssignedCoupons", fields: [assignedUserId], references: [id])

  expiresAt DateTime

  isDeleted Boolean @default(false)

  usages CouponUsage[]
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedUserId])
}

model CouponProduct {
  id String @id @default(cuid())

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([couponId, productId])
  @@index([couponId])
  @@index([productId])
}

model CouponCategory {
  id String @id @default(cuid())

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([couponId, categoryId])
  @@index([couponId])
  @@index([categoryId])
}

// One row per successful redemption — this is what "is used" really means
// once more than one user (and more than one use-per-user in theory) is
// possible. Also gives us a natural audit trail.
model CouponUsage {
  id String @id @default(cuid())

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  usedAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
}

enum OrderStatus {
  PENDING // order row created, awaiting payment
  CONFIRMED // payment succeeded, stock deducted — irreversible by the user from here
  COMPLETED // admin marked as sent/delivered
  CANCELLED // admin cancelled (only path once CONFIRMED); or auto-cancelled if payment never completed
}

enum CourierType {
  SNAPP_BOX // شیراز
  TIPAX // everywhere else
}

// Snapshot-style order: item price/title are copied at order time so later
// product edits/deletions never change historical order data.
model Order {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status OrderStatus @default(PENDING)

  // Address snapshot (copied from the user's Address at checkout time, so
  // editing their saved address later doesn't rewrite past orders).
  receiverFullName String
  receiverPhone    String
  province         String
  city             String
  fullAddress      String
  postalCode       String

  courierType CourierType // derived from city at checkout time, stored for admin fulfillment

  items OrderItem[]

  subtotal        Int // sum of item price*qty, before discount
  discountAmount  Int @default(0)
  totalAmount     Int // subtotal - discountAmount — this is what's charged via ZarinPal

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])
  couponUsage CouponUsage?

  payment Payment?
  review  ProductReview?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// Snapshot of what was purchased — never references live price/title, so
// the order stays accurate even if the product/variant is edited or
// deleted later.
model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String? // nullable: kept even if the variant is later deleted
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productTitle  String // snapshot
  optionSummary String? // snapshot, e.g. "Size: SM / Color: Red"
  unitPrice     Int // snapshot, Toman
  quantity      Int

  @@index([orderId])
  @@index([variantId])
}

enum PaymentStatus {
  PENDING // redirected to ZarinPal, awaiting callback
  SUCCESS
  FAILED
}

// One-to-one with Order. Re-payment (per your spec: user can retry if
// payment failed) reuses the same Payment row — authority/refId get
// overwritten with each attempt, which is fine since we only care about
// the latest attempt's outcome.
model Payment {
  id String @id @default(cuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status PaymentStatus @default(PENDING)

  amount Int // Toman, should equal order.totalAmount

  authority String? // ZarinPal "Authority" token for this attempt
  refId     String? // ZarinPal "RefID" returned on success

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// MODULE 5 — Notifications (Web Push + SMS) & PWA
// ============================================================================

// A browser's Web Push subscription. One user can have multiple (different
// devices/browsers) — all get pushed to when a notification fires.
model PushSubscription {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String // encryption key, part of the browser's subscription object
  auth     String // auth secret, part of the browser's subscription object

  createdAt DateTime @default(now())

  @@index([userId])
}

enum NotificationChannel {
  PUSH // browser push only
  SMS // SMS only
  BOTH // both push and SMS were sent for this event
}

// One row per notification "event" delivered to ONE specific recipient
// (a user, or an admin — admin is just a User with role=ADMIN, same
// table). This is also what powers the /notifications page (read/unread,
// read-all) — it's the source of truth, not just a delivery log.
model Notification {
  id String @id @default(cuid())

  userId String // recipient — a normal user OR an admin
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  body    String
  channel NotificationChannel

  // Optional deep link so tapping the notification/row can jump straight
  // to the relevant page (e.g. an order detail page).
  linkUrl String?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

// ============================================================================
// MODULE 7 — Reviews (product reviews + site-satisfaction popup)
// ============================================================================

// One review per whole order (per your spec), not per product/item.
// Rating always required; text is optional. Reviews with text go through
// admin approval before being publicly visible; a rejected review is
// deleted outright (per your spec — "delete it, don't tell anyone").
// A review with NO text never needed approval in the first place — see
// the approval logic note on ReviewStatus below.
enum ReviewStatus {
  PENDING // has text, awaiting admin approval
  APPROVED // visible on the product detail page(s) for this order's products
}

model ProductReview {
  id String @id @default(cuid())

  orderId String @unique // one review per whole order
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating Int // 1-5
  text   String? // optional — presence of text is what triggers the approval flow

  status ReviewStatus @default(APPROVED) // see note: text-less reviews are auto-approved

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}

// Rating-only (+ optional text, per your final answer) site-satisfaction
// popup. Admin-only visibility — never shown publicly anywhere.
model SiteSatisfactionRating {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating Int // 1-5
  text   String?

  createdAt DateTime @default(now())

  @@index([userId])
}

// Tracks which popups a user has permanently dismissed, per popup type
// (per your confirmed spec: dismissing one type doesn't silence the
// other). Once a row exists for (userId, popupType), never show that
// popup to that user again.
enum PopupType {
  ORDER_REVIEW_PROMPT
  SITE_SATISFACTION
}

model PopupDismissal {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  popupType PopupType

  createdAt DateTime @default(now())

  @@unique([userId, popupType])
  @@index([userId])
}

// ============================================================================
// MODULE 8 — Stories (Instagram-style, shown above products)
// ============================================================================

enum StoryMediaType {
  IMAGE
  VIDEO
}

model Story {
  id String @id @default(cuid())

  mediaType StoryMediaType
  mediaUrl  String // image: compressed to WebP. video: size/duration-limited,
                    // NOT compressed yet — deferred to end-of-project, see README.

  description String?

  // Default 24h from creation, but admin can set any custom duration —
  // set this to `createdAt + N hours` at creation/edit time.
  expiresAt DateTime

  products StoryProduct[] // optional — a story may link zero, one, or many products
  views    StoryView[]

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@index([isDeleted])
}

model StoryProduct {
  id String @id @default(cuid())

  storyId String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storyId, productId])
  @@index([storyId])
  @@index([productId])
}

// One row per (story, user) — this is what makes "seen count" correct
// (counts each user once, no matter how many times they replay the
// story) and what drives the "push already-seen stories back" ordering,
// computed at query time rather than stored.
model StoryView {
  id String @id @default(cuid())

  storyId String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  @@unique([storyId, userId])
  @@index([storyId])
  @@index([userId])
}




